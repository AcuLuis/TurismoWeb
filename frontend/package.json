  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@quasar/app-vite": "^3.10.4",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.33",
    "prettier": "^3.6.2",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^24 || ^22.22.0",
    "npm": ">= 6.13.4"
  }
