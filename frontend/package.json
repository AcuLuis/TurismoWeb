{
  "name": "turismogo-frontend",
  "version": "1.0.0",
  "description": "TurismoGo: marketplace de actividades turísticas",
  "productName": "TurismoGo",
  "author": "Luis Antonio Acuña Ayala",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path ../.gitignore",
    "test": "vitest run",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.18.0",
    "axios": "^1.21.1",
    "pinia": "^3.0.4",
